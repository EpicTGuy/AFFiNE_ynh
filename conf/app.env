# Base de données PostgreSQL (avec extension pgvector)
DATABASE_URL=postgresql://__DB_USER__:__DB_PWD__@localhost:5432/__DB_NAME__

# Redis
REDIS_SERVER_HOST=localhost
REDIS_SERVER_PORT=6379

# Serveur
NODE_ENV=production
PORT=__PORT__
AFFINE_SERVER_EXTERNAL_URL=https://__DOMAIN____PATH__

# Chemins de données (remplacent /root/.affine de l'image Docker)
AFFINE_CONFIG_PATH=__DATA_DIR__/config

# Désactiver l'indexeur vectoriel (économise ~500 Mo RAM, peut être activé manuellement)
AFFINE_INDEXER_ENABLED=false
