#!/bin/bash
source _common.sh
source /usr/share/yunohost/helpers

ynh_script_progression --message="Deploying source files..." --weight=10
# Workaround: replace vendored script until YunoHost/yunohost#2293 is merged
# (adds OCI multi-registry support required for ghcr.io images)
cp "$YNH_APP_BASEDIR/conf/docker-image-extract" \
   "$YNH_HELPERS_DIR/vendor/docker-image-extract/docker-image-extract"
ynh_setup_source --dest_dir="$install_dir"

ynh_script_progression --message="Enabling pgvector extension..." --weight=1
sudo -u postgres psql --dbname="$db_name" --command="CREATE EXTENSION IF NOT EXISTS vector;"

ynh_script_progression --message="Configuring AFFiNE..." --weight=1
ynh_config_add --template="app.env" --destination="$install_dir/app/.env"
chmod 600 "$install_dir/app/.env"
chown "$app:$app" "$install_dir/app/.env"

mkdir -p "$data_dir/storage" "$data_dir/config"
chown -R "$app:$app" "$data_dir"
chown -R "$app:$app" "$install_dir"

ynh_script_progression --message="Running database migration..." --weight=5
pushd "$app_dir"
ynh_exec_as_app env HOME="$data_dir" \
    "$nodejs_bin" node_modules/prisma/build/index.js migrate deploy
ynh_exec_as_app env HOME="$data_dir" SERVER_FLAVOR=script \
    "$nodejs_bin" dist/main.js run
popd

ynh_script_progression --message="Configuring NGINX..." --weight=1
ynh_config_add_nginx

ynh_script_progression --message="Configuring systemd service..." --weight=1
ynh_config_add_systemd
mkdir -p "/var/log/$app"
chown "$app:$app" "/var/log/$app"
yunohost service add "$app" \
    --description="AFFiNE knowledge base" \
    --log="/var/log/$app/$app.log"

ynh_script_progression --message="Starting AFFiNE..." --weight=10
ynh_systemctl \
    --service="$app" \
    --action="start" \
    --log_path="/var/log/$app/$app.log" \
    --wait_until="Listening on"

ynh_script_progression --message="Installation completed" --last
