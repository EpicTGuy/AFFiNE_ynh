#!/bin/bash
source ../settings/scripts/_common.sh
source /usr/share/yunohost/helpers

ynh_script_progression --message="Restoring files..." --weight=5
ynh_restore "$install_dir"
ynh_restore "$data_dir"
chown -R "$app:$app" "$install_dir"
chown -R "$app:$app" "$data_dir"

ynh_restore "/etc/nginx/conf.d/$domain.d/$app.conf"
ynh_systemctl --action="reload" --service="nginx"
ynh_restore "/etc/systemd/system/$app.service"
systemctl enable "$app.service" --quiet
systemctl daemon-reload

ynh_script_progression --message="Reconfiguring AFFiNE..." --weight=1
ynh_config_add --template="app.env" --destination="$install_dir/app/.env"
chmod 600 "$install_dir/app/.env"
chown "$app:$app" "$install_dir/app/.env"

mkdir -p "/var/log/$app"
chown "$app:$app" "/var/log/$app"

ynh_script_progression --message="Enabling pgvector extension..." --weight=1
sudo -u postgres psql --dbname="$db_name" --command="CREATE EXTENSION IF NOT EXISTS vector;"

ynh_script_progression --message="Running database migration..." --weight=5
pushd "$app_dir"
ynh_exec_as_app env HOME="$data_dir" \
    "$nodejs_bin" node_modules/prisma/build/index.js migrate deploy
ynh_exec_as_app env HOME="$data_dir" SERVER_FLAVOR=script \
    "$nodejs_bin" dist/main.js run
popd

yunohost service add "$app" \
    --description="AFFiNE knowledge base" \
    --log="/var/log/$app/$app.log"

ynh_script_progression --message="Restarting AFFiNE..." --weight=10
ynh_systemctl \
    --service="$app" \
    --action="start" \
    --log_path="/var/log/$app/$app.log" \
    --wait_until="Listening on"

ynh_script_progression --message="Restoration completed" --last
